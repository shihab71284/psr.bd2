# PostgreSQL Database Connection URL (e.g. postgresql://user:password@localhost:5432/taxdb)
# সতর্কতা: লাইভ Vercel-এ এটি সেট না থাকলে অ্যাপ in-memory mock DB-তে চলে —
# রেজিস্টার/সাবস্ক্রিপশন ডেটা রিস্টার্টে মুছে যায় এবং ডেমো অটো-লগইন বন্ধ করা যায় না।
DATABASE_URL=

# Secret key for JWT session signing (at least 32 characters recommended)
AUTH_SECRET=

# Public base URL (কলব্যাক URL তৈরিতে ব্যবহৃত হয়)
NEXT_PUBLIC_APP_URL=https://psr.bd

# ---------------------------------------------------------------------------
# নিজস্ব পেমেন্ট গেটওয়ে — সরাসরি মার্চেন্ট ইন্টিগ্রেশন (bKash / Nagad /
# Bangla QR / ব্যাংক IPG)। কোনোটাই সেট না থাকলে পেমেন্ট বোতাম
# "শীঘ্রই আসছে" অবস্থায় থাকে — ভুয়া পেমেন্ট কখনোই হয় না।
# ক্রেডেনশিয়াল কখনো Git-এ কমিট করবেন না; Vercel Environment Variables-এ রাখুন।
# ---------------------------------------------------------------------------

# bKash — Tokenized Checkout v1.2.0-beta (developer.bka.sh)
# Live: https://tokenized.pay.bka.sh/v1.2.0-beta
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad — Payment Gateway (developer.nagad.com.bd)
# Live: https://api.nagad.com.bd/remote-payment-gateway-1.0/api/dfs
# Sandbox: https://sandboxapi.nagad.com.bd/remote-payment-gateway-1.0/api/dfs
# প্রাইভেট/পাবলিক কী PEM ফরম্যাটে; লাইনব্রেক \n দিয়ে লিখুন।
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
# Nagad-এ হোয়াইটলিস্ট করা সার্ভার IP (X-KM-IP-V4 হেডার) — Vercel-এ স্থির IP
# নেই, তাই মার্চেন্ট অনবোর্ডিংয়ের সময় Nagad-এর সঙ্গে আলোচনা করতে হবে।
NAGAD_SERVER_IP=

# Bangla QR — অ্যাকোয়ারিং ব্যাংকের ডায়নামিক QR API
# (Bangladesh Bank-এর একক কোনো API নেই — ব্যাংক থেকে বিবরণ নিতে হবে)
BANGLA_QR_API_URL=
BANGLA_QR_MERCHANT_ID=
BANGLA_QR_API_KEY=

# ব্যাংক কার্ড / ইন্টারনেট ব্যাংকিং — অ্যাকোয়ারিং ব্যাংকের IPG
BANK_IPG_BASE_URL=
BANK_IPG_MERCHANT_ID=
BANK_IPG_API_KEY=
